ENVIRONMENT=development

# ── Local models through the epsilon engine (../engine) ─────────────────────
ENGINE_ENABLED=true

# ── Optional FREE cloud LLM for lower latency (any OpenAI-compatible API) ───
# Groq (free tier)      https://api.groq.com/openai/v1                        llama-3.3-70b-versatile
# Gemini (free tier)    https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.0-flash
# OpenRouter (free)     https://openrouter.ai/api/v1                          meta-llama/llama-3.3-70b-instruct:free
CLOUD_LLM_BASE_URL=
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=
# local = epsilon engine first, cloud fallback | cloud = cloud first, local fallback
LLM_PREFER=local

# ── Voice (free neural voices via edge-tts) ─────────────────────────────────
TTS_VOICE_EN=en-IN-NeerjaExpressiveNeural
TTS_VOICE_HI=hi-IN-SwaraNeural

# ── Gnani (https://gnani.ai): Indian-accent STT with VAD + neural TTS, also for phone calls ─
GNANI_API_KEY=
GNANI_VOICE=Nalini
# auto = Gnani when a key is set, then edge-tts, then the browser's own voice
TTS_PROVIDER=auto
STT_PROVIDER=auto

# ── Phone calls (Twilio Media Streams). Public URL of this API, e.g. from ngrok/cloudflared ─
PUBLIC_BASE_URL=

# Providers that do not use "Authorization: Bearer" (Sarvam: api-subscription-key)
CLOUD_LLM_AUTH_HEADER=Authorization

# Recognise your own phone as a demo customer: "+91XXXXXXXXXX:CUS-20481,+91YYYYYYYYYY:CUS-20517"
PHONE_ALIASES=

# ── Twilio (only for the "Call me" button: Twilio dials your phone and connects it to the agent) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Email ─────────────────────────────────────────────────────────────────────
# Works out of the box with a built-in simulated inbox (Team console → Emails). For REAL email, use a Gmail address:
#   1) turn on 2-step verification, 2) create an App Password (Google Account → Security → App passwords).
EMAIL_ADDRESS=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_IMAP_HOST=imap.gmail.com
# While testing, deliver EVERY outgoing email to this one inbox (the customer's address is shown in the message):
EMAIL_REDIRECT_TO=
# Map real addresses to demo customers for incoming mail: "you@gmail.com:CUS-20481,friend@gmail.com:CUS-20517"
EMAIL_ALIASES=
# Send the customer a summary after every call or chat (true / false)
EMAIL_SUMMARIES=true

# Real addresses for the demo customers (kept here, not in the committed seed data): "CUS-20481:a@gmail.com,CUS-20517:b@gmail.com"
CUSTOMER_EMAILS=

# ── Hosted UI (Vercel) calling this backend through ngrok: see start-public.ps1 ─
# NGROK_DOMAIN=your-name.ngrok-free.app     free static domain from the ngrok dashboard (Domains); keeps the address fixed
# VERCEL_APP_URL=https://resolvyn.vercel.app  lets the script print a link that points the site at this backend
# CORS_ORIGINS=["https://resolvyn.example.com"]  only for a custom domain (*.vercel.app and localhost are already allowed)
